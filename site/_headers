/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://choisijun.com; connect-src 'self' https://choisijun.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/api/*
  Cache-Control: no-store

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

/img/*
  Cache-Control: public, max-age=604800

# AI 검색·챗봇용 요약 문서 — 누구나 읽을 수 있지만 검색 결과에는 원래 페이지가 나오도록 합니다
/llms/*
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/search-index.json
  Cache-Control: public, max-age=600
